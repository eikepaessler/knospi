{
  "name": "knospi",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "mobile"
  ],
  "scripts": {
    "dev": "concurrently -n server,mobile -c green,cyan \"npm run dev -w server\" \"npm run start -w mobile\"",
    "dev:server": "npm run dev -w server",
    "dev:mobile": "npm run start -w mobile",
    "web-preview": "npm run web -w mobile",
    "seed": "npm run seed -w server",
    "start": "node server/src/index.js"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
