{
  "name": "knospi",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "seed": "npm run seed -w server",
    "start": "node server/src/index.js"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
